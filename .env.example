# AJVAS CHOCOLATES - Environment Variables Template
# Copy this file to .env.local and populate with your project credentials.

# Supabase Public Configuration (Accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Supabase Server-Only Configuration (CRITICAL: Never prefix with NEXT_PUBLIC_ or expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret-here

